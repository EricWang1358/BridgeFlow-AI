# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Node
node_modules/
.next/
dist/
build/
*.tsbuildinfo

# Env & secrets
.env
.env.*
!.env.example
*.key
*.pem
# env.sh and every copy of it (env.sh.bak-…): each holds the instance's secrets.
env.sh*
!env.sh.example

# dsh runtime homes — must live outside the repo, but ignore them if anyone
# points DSH_HOME inside it by mistake.
.dsh*/

# Data (keep samples, ignore real uploads)
data/uploads/
data/outputs/
# Real OA master data — only the example is tracked.
data/mappings/field-dictionary.yaml
# Instance configuration is private; only *.example.yaml templates are tracked.
data/mappings/access-control.yaml
data/mappings/access-control.yaml.*
data/mappings/seats.yaml
data/mappings/seats.yaml.*
# Runtime homes and seat assignments are also instance-local.
data/homes/
data/guest/
# Demo model gate state: its client token and per-day ledger (docs/36 §6).
data/gate/
data/seats-assigned.json
*.xlsx
*.xls
!data/samples/*.csv
# Business-provided templates (headers only) and their synthetic worked example.
!data/company_templates/**/*.xlsx
!data/mock_business/**/*.xlsx
# Their English translation for the public demo (scripts/make_english_samples.py).
!data/demo_en/**/*.xlsx

# Logs
*.log

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

logs/

# Internal working notes, recordings and generated evidence do not ship publicly.
.claude/
.codegraph/
CLAUDE.md
HANDOFF.md
docs/evidence/
docs/images/
docs/design/
docs/requirements/
submission/
demo-walkthrough/
