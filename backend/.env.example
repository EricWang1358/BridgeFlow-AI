# Which provider the agents talk to. "mock" needs no key and is fully offline.
# One of: mock | dsh | anthropic | hermes | deepseek | openclaw
LLM_PROVIDER=mock

# Optional per-agent overrides — cheap model for cleaning, strong model for judgement.
# LLM_PROVIDER_SANITIZER=deepseek
# LLM_PROVIDER_EVALUATOR=anthropic

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- DeepSeek Harness (dsh) — agent runtime, LLM_PROVIDER=dsh ---
# Required. The SDK never discovers ~/.dsh; point this at an isolated directory.
DSH_HOME=
DSH_PROFILE=sdk
DSH_PROVIDER=deepseek-official
DSH_MODEL=deepseek-v4-flash
# DSH_REASONING_EFFORT=
# DSH_MAX_TOKENS=
# DSH_CWD=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

HERMES_API_KEY=
HERMES_BASE_URL=
HERMES_MODEL=

OPENCLAW_API_KEY=
OPENCLAW_BASE_URL=
OPENCLAW_MODEL=

# Cross-department mappings declared by OA. See data/mappings/README.md.
FIELD_DICTIONARY_PATH=data/mappings/field-dictionary.yaml

# Links below this confidence are handed to a human instead of applied silently.
RESOLVER_CONFIDENCE_THRESHOLD=0.75
