# Bind address. Keep 127.0.0.1 by default; use 0.0.0.0 only when something
# outside the machine must reach it (WSL testing from Windows, containers).
API_HOST=127.0.0.1
API_PORT=8000
# Comma-separated allowed origins. Override in production, never hardcode.
CORS_ORIGINS=

# Which provider the agents talk to. "mock" needs no key and is fully offline.
# One of: mock | dsh | anthropic | hermes | deepseek | openclaw
LLM_PROVIDER=mock

# Optional per-agent overrides — cheap model for cleaning, strong model for judgement.
# LLM_PROVIDER_SANITIZER=deepseek
# LLM_PROVIDER_EVALUATOR=anthropic

# The resolver only ever asks for a single judgement, so it goes straight to
# DeepSeek's chat-completions endpoint instead of through the dsh agent runtime.
# See issue #25: on dsh the same call ran 12 bash steps over the repository.
# LLM_PROVIDER_RESOLVER=deepseek

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- DeepSeek Harness (dsh) ---
# DSH_HOME / DSH_PROFILE / DSH_PROVIDER / DSH_MODEL / DEEPSEEK_BASE_URL must NOT
# be set here. dsh scans this file and refuses bootstrap and network variables
# read from it — they decide where code loads from and where traffic goes, so a
# checked-in file must not be able to set them. Use env.sh.example instead.

# DEEPSEEK_API_KEY and DEEPSEEK_BASE_URL live in env.sh, not here.
# An EMPTY DEEPSEEK_BASE_URL= line still counts as "set" and dsh will refuse to
# start, so the line must be absent rather than blank.
DEEPSEEK_MODEL=

HERMES_API_KEY=
HERMES_BASE_URL=
HERMES_MODEL=

OPENCLAW_API_KEY=
OPENCLAW_BASE_URL=
OPENCLAW_MODEL=

# Cross-department mappings declared by OA. See data/mappings/README.md.
FIELD_DICTIONARY_PATH=data/mappings/field-dictionary.yaml

# Links below this confidence are handed to a human instead of applied silently.
RESOLVER_CONFIDENCE_THRESHOLD=0.75

# Native Web: the launcher generates a shared host token in process environment.
# Direct backend development must supply the same 32+ character token to the host.
BRIDGEFLOW_ENABLE_LEGACY_CONSOLE=false
BRIDGEFLOW_ENABLE_LEGACY_PIPELINE=false
BRIDGEFLOW_ALLOW_SAMPLE_DATA=false
BRIDGEFLOW_ALLOW_MAPPING_WRITE=true
BRIDGEFLOW_MAX_UPLOAD_BYTES=26214400
BRIDGEFLOW_MAX_BATCH_ROWS=200000
