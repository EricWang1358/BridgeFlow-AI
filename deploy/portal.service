# systemd unit for the login portal on the Lightsail instance (see
# docs/deployment.md). Install as
# /etc/systemd/system/bridgeflow-portal.service, then:
#
#   sudo systemctl daemon-reload && sudo systemctl enable --now bridgeflow-portal
#
# Like bridgeflow.service, this sources env.sh via bash so PORTAL_* (Feishu app
# credentials, signing-key path, session secret) come from the launching shell
# only — never from this file and never from .env, the same boundary as DSH_*.
# Loopback-only: Caddy terminates TLS for portal.<domain> and proxies here.
#
# The unit assumes `uv pip install -e portal` has put portal_app into the venv;
# deploy.sh does that on every deploy.
#
# --ws none: the portal serves no WebSocket route at all, and with a ws library
# installed uvicorn hands ANY request carrying Connection/Upgrade to its
# WebSocket protocol — which then answers 403 because no ws route matches. That
# turned Caddy's forward_auth subrequest for a console WebSocket into a denial
# and took the seats' /api/remote.mux down with it (2026-09-21, docs/deployment.md).
# Caddy no longer forwards those headers, and this says the same thing from the
# other side: this process answers HTTP, never an upgrade.

[Unit]
Description=BridgeFlow unified login portal (Feishu OAuth, signs app tokens)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/Hackathon2026/BridgeFlow-AI
ExecStart=/bin/bash -c 'source env.sh && exec /home/ubuntu/Hackathon2026/.venv/bin/python -m uvicorn portal_app.main:app --host 127.0.0.1 --port 8100 --ws none'
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
