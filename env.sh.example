# Launching-environment variables for dsh. Source this before running anything
# that starts the runtime:
#
#     cp env.sh.example env.sh   # then fill it in
#     source env.sh
#
# WHY THESE CANNOT LIVE IN backend/.env
# -------------------------------------
# dsh scans the .env file in its working directory and REFUSES to read
# bootstrap variables from it:
#
#   dsh: .../.env sets "DSH_HOME", which only the launching environment may set
#   (it decides how this process starts, where its code and instructions load
#   from, or how it reaches the network); export DSH_HOME instead
#
# That is a security boundary, not an inconvenience. If a checked-in file could
# set where the runtime loads code from or which host it talks to, cloning a
# hostile repository would be enough to redirect both. Respect it — do not try
# to work around it by moving the runtime's cwd.
#
# env.sh is gitignored. Keep secrets here, never in a tracked file.

# Where dsh keeps profiles, plugins, credentials and sessions.
# Must be absolute, and must sit OUTSIDE the repository.
export DSH_HOME="$HOME/Hackathon2026/.dsh-bridgeflow"

export DSH_PROFILE=sdk-minimal
export DSH_PROVIDER=deepseek-official
export DSH_MODEL=deepseek-v4-flash

export DEEPSEEK_API_KEY=""

# Only set this if you are pointing at a non-default endpoint. It reaches both
# dsh and our direct DeepSeek provider, and dsh treats it as an override, so
# leaving it unset is what you want against the official API.
# export DEEPSEEK_BASE_URL="https://api.deepseek.com"

# Domain configuration for scripts/start_web.py (launched from the repo root).
export FIELD_DICTIONARY_PATH="data/mappings/field-dictionary.yaml"
# For rehearsal only: data/mappings/field-dictionary.example.yaml
# Shared Web + Python SDK executable, pinned to 0.1.2-rc.1.
# Do not run the Python packed CLI against this home while Web is alive:
# it rewrites shared module fallbacks into its private /snapshot filesystem.
# For direct SDK experiments, pass dsh_bin explicitly or use a separate DSH_HOME.
# Optional override:
# export BRIDGEFLOW_DSH="/absolute/path/to/npm/bin/dsh"

# Feishu Drive shortcuts (#140). A self-built app's credentials; leave unset to keep them off.
# export FEISHU_APP_ID=
# export FEISHU_APP_SECRET=

# Login portal (docs/27): portal/ proves users via Feishu OAuth and signs app tokens.
# May be the SAME self-built app as the Drive shortcuts (enable "web app" login and set
# the redirect URL to $PORTAL_EXTERNAL_BASE_URL/callback in the Feishu console).
# export PORTAL_FEISHU_APP_ID=
# export PORTAL_FEISHU_APP_SECRET=
# Generate once, keep OUTSIDE the repository: python -m portal_app.keygen ~/.portal-key.pem
# export PORTAL_KEY_PATH="$HOME/.portal-key.pem"
# export PORTAL_SESSION_SECRET=            # 32+ random characters
# export PORTAL_EXTERNAL_BASE_URL="http://127.0.0.1:8100"
# Set only behind HTTPS, when the main site's forward_auth must read the session
# cookie too (parent domain, leading dot). Empty = host-only cookie (local dev).
# export PORTAL_COOKIE_DOMAIN=
# Backend: point BridgeFlow at the portal to turn the identity layer on (empty = off).
# export PORTAL_BASE_URL="http://127.0.0.1:8100"
